---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { site, withBase } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object;
}

const {
  title,
  description = site.description,
  image = '/img/og.jpg',
  type = 'website',
  canonical = site.url + Astro.url.pathname,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.shortTitle}` : site.title;
const imageUrl = withBase(image);
---

<!doctype html>
<html lang="en" data-theme="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Theme: set before paint to avoid flash -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- KOD BLOKLARI İÇİN KOPYALA BUTONU VE SCROLL STİLLERİ -->
    <style is:global>
      .copy-code-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        background-color: #2d2d2d;
        color: #e0e0e0;
        border: 1px solid #444;
        padding: 6px 12px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 500;
        opacity: 0.8;
        transition: all 0.2s ease;
        z-index: 10;
      }

      .copy-code-btn:hover {
        opacity: 1;
        background-color: #444;
      }

      .copy-code-btn.copied {
        background-color: #10b981; 
        color: white;
        border-color: #10b981;
      }
    </style>

    <!-- KOD BLOKLARI İÇİN JAVASCRIPT KURALI -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Sayfadaki tüm <pre> etiketlerini (kod bloklarını) bul
        const codeBlocks = document.querySelectorAll('pre');

        codeBlocks.forEach((block) => {
          // Kutuyu oluştur
          const wrapper = document.createElement('div');
          wrapper.style.position = 'relative';
          wrapper.style.marginBottom = '2rem';
          
          // Kod bloğunu kutunun içine al
          block.parentNode.insertBefore(wrapper, block);
          wrapper.appendChild(block);
          
          // Scroll özelliklerini ekle
          block.style.maxHeight = '400px'; 
          block.style.overflowY = 'auto';
          block.style.margin = '0';
          
          // Butonu oluştur ve ekle
          const copyBtn = document.createElement('button');
          copyBtn.innerText = 'Kopyala';
          copyBtn.className = 'copy-code-btn';
          
          wrapper.appendChild(copyBtn);
          
          // Kopyalama işlevini ekle
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(block.innerText).then(() => {
              copyBtn.innerText = 'Kopyalandı!';
              copyBtn.classList.add('copied');
              
              setTimeout(() => {
                copyBtn.innerText = 'Kopyala';
                copyBtn.classList.remove('copied');
              }, 2000);
            }).catch(err => {
              console.error('Kopyalama işlemi başarısız oldu: ', err);
            });
          });
        });
      });
    </script>
  </body>
</html>